# Copy to .env and fill in — never commit the real .env (see .gitignore)
# Every setting is optional: with none of them the app runs on SQLite, the processed CSV files, no sign-in and no
# outbound integration. This file exists so §23 (no hardcoded credentials) is designed in from day one.

# --- LLM (Sensing Agent) — Google Gemini free tier (aistudio.google.com), no card required ---
# Read from the process environment; nothing loads this file for you. Export the values
# (or run the API with `uvicorn --env-file .env`). Optional live LLM tests: RUN_LIVE_LLM_TESTS=1 pytest
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# --- Database (MVP: SQLite file; production: SAP HANA Cloud) ---
DATABASE_URL=sqlite:///./resilientsc.db

# --- Observability (Phase 19) — also settable in backend/config/monitoring.yaml; the environment wins ---
# LOG_LEVEL=INFO                 # DEBUG also logs the polled endpoints (health, ready, metrics, run status)
# LOG_FORMAT=text                # text for a terminal; json = one object per line, for a log pipeline
# RUN_OVERDUE_SECONDS=120        # a run RUNNING longer than this is reported `overdue` in its status

# --- API ---
# Comma-separated browser origins allowed to call the API (default: the Vite dev server)
# CORS_ORIGINS=http://localhost:5173

# --- SAP HANA Cloud / SAP BTP / SAP Integration Suite (Phase 21) — see docs/sap-readiness.md ---
# On BTP a bound `hana` instance is found in VCAP_SERVICES by itself; these are for running against a tenant from your machine.
# DATABASE_URL=hana+hdbcli://USER:PASSWORD@HOST:443?encrypt=true&sslValidateCertificate=true    # pip install -r requirements-sap.txt
# DATABASE_SCHEMA=RESILIENTSC        # qualify every table with this schema
# DATABASE_AUTO_CREATE=true          # false where the user may not run DDL: create the tables from db/hana/schema.sql
# DATA_BACKEND=csv                   # sql: read the reference data from ref_* tables (load them: python scripts/load_reference_data.py)
# DATA_DATABASE_URL=                 # sql: a different database for them (default: the world-state database)
#
# AUTH_MODE=none                     # jwt: every request needs a bearer token (default: jwt if an xsuaa instance is bound, else none)
# AUTH_JWKS_URL=                     # jwt, when not taken from the XSUAA binding (e.g. SAP Cloud Identity Services)
# AUTH_ISSUER=
# AUTH_AUDIENCE=                     # comma-separated
# AUTH_SCOPE_PREFIX=                 # e.g. resilientsc!t12345.  (XSUAA prefixes scope names with the app name)
#
# EVENTS_BACKEND=none                # log | webhook: CloudEvents to an Integration Suite endpoint
# EVENTS_WEBHOOK_URL=                # https://...   {topic} and {type} are filled in per event
# EVENTS_AUTH=                       # none | basic | bearer | oauth2 (oauth2 when EVENTS_OAUTH_TOKEN_URL is set)
# EVENTS_OAUTH_TOKEN_URL=            # from the Integration Suite / Event Mesh service key
# EVENTS_OAUTH_CLIENT_ID=
# EVENTS_OAUTH_CLIENT_SECRET=
# EVENTS_BASIC_USER= / EVENTS_BASIC_PASSWORD= / EVENTS_BEARER_TOKEN=
# EVENTS_CHECKPOINTS=                # all, or a comma list (default: the six business milestones)
#
# LLM_PROVIDER=gemini                # a registered provider; SAP AI Core is the intended second one (not yet written)

# --- Compliance thresholds (also configurable via backend/config/compliance_rules.yaml) ---
APPROVAL_THRESHOLD_INR=5000000

# --- Groq (Compliance Agent's plain-English explanation layer ONLY) ---
# The compliance decision itself (APPROVED/REJECTED/ESCALATED) stays 100% deterministic,
# rule-based, and unaffected by this key — see backend/agents/compliance/llm.py and
# docs/agent-plan.md §12. With no key, compliance still runs; verdicts just have no
# written rationale for the human reviewer. Free tier at console.groq.com, no card required.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
